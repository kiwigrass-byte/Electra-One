local sysex_states = {}

local VENDOR_ID = {0x00, 0x20, 0x32} -- Behringer
local MODEL_BYTE = 0x3A              -- UB-Xa model identifier
local HEADER_MSG_TYPE = 1
local PACKET_MSG_TYPE = 2
local EOF_SYSEX_SECOND_BYTE = 0x7E

local function safe_peek(sysexBlock, length, i)
  if type(i) ~= "number" or i < 1 or i > length then return nil end
  -- assume sysexBlock:peek exists and returns a number for that index
  return sysexBlock:peek(i)
end

local function peek_string(sysexBlock, length, startIndex, count)
  if startIndex < 1 or count < 1 then return "" end
  local t = {}
  for j = 0, count - 1 do
    local b = safe_peek(sysexBlock, length, startIndex + j)
    if not b then break end
    t[#t+1] = string.char(b)
  end
  return table.concat(t)
end

local function is_vendor_match(sysexBlock, length)
  return safe_peek(sysexBlock, length, 2) == VENDOR_ID[1]
     and safe_peek(sysexBlock, length, 3) == VENDOR_ID[2]
     and safe_peek(sysexBlock, length, 4) == VENDOR_ID[3]
end

function midi.onSysex(midiInput, sysexBlock)
  local ok, err = pcall(function()
    -- basic validation
    if not midiInput or not sysexBlock then
      print("onSysex: missing midiInput or sysexBlock")
      return
    end
    if type(sysexBlock.getLength) ~= "function"
    or type(sysexBlock.peek) ~= "function" then
      print("onSysex: sysexBlock lacks required methods")
      return
    end

    local length = sysexBlock:getLength()
    if type(length) ~= "number" or length < 1 then
      print("onSysex: invalid sysex length")
      return
    end

    local iface = tostring(midiInput.interface or midiInput.name or "unknown")
    local state = sysex_states[iface]
    if not state then
      state = { msgNumber = 0, dump = {}, p_flag = false, g_flag = false, a_flag = false }
      sysex_states[iface] = state
    end

    local peek = function(i) return safe_peek(sysexBlock, length, i) end

    -- detect header message
    if length > 6 and peek(11) == HEADER_MSG_TYPE then
      state.msgNumber = 1
    end

    -- if we have a header, validate vendor & model and detect dump type reliably
    if state.msgNumber == 1 then
      if not is_vendor_match(sysexBlock, length) then
        print("onSysex: Not Behringer vendor; ignoring message")
        return
      end
      if peek(7) ~= MODEL_BYTE then
        print("onSysex: Not UB-Xa model; ignoring message")
        return
      end

      -- peek ASCII fields safely. header's ASCII starts at position 21 in original code
      local hdrText = peek_string(sysexBlock, length, 21, 32 - 21 + 1)
      hdrText = hdrText or ""
      -- normalize for comparisons
      local textLower = hdrText:lower()
      if textLower:find("upper patch", 1, true) then
        state.p_flag, state.g_flag, state.a_flag = true, false, false
      elseif textLower:find("global", 1, true) then
        state.g_flag, state.p_flag, state.a_flag = true, false, false
      elseif textLower:find("atrophy", 1, true) then
        state.a_flag, state.p_flag, state.g_flag = true, false, false
      end
    end

    -- update message number for packet messages (safe loop)
    for i = 0, 6 do
      if length > 6 and peek(11) == PACKET_MSG_TYPE and peek(12) == i then
        state.msgNumber = i + 2
      end
    end

    -- fallback: if we've accumulated 8 packets, mark as full patch
    if state.msgNumber == 8 then state.p_flag = true end

    -- EOF detection (ensure length check and that second byte matches expected EOF marker)
    local secondByte = peek(2)
    if length == 6 and secondByte == EOF_SYSEX_SECOND_BYTE then
      if state.p_flag then
        state.msgNumber = 9
      elseif state.a_flag then
        state.msgNumber = 3
      elseif state.g_flag then
        state.msgNumber = 5
      end
    end

    -- logging summary
    print(string.format("sysex (msg=%d) received: interface=%s length=%d",
      state.msgNumber, iface, length))

    -- hex dump (safe)
    for startIndex = 1, length, 16 do
      local bytes = {}
      local endIndex = math.min(startIndex + 15, length)
      for i = startIndex, endIndex do
        local b = peek(i) or 0
        bytes[#bytes + 1] = string.format("%02X", b)
      end
      print(string.format("data[%04X]: %s", startIndex - 1, table.concat(bytes, " ")))
    end

    -- collect message bytes into temp table
    local temp = {}
    for i = 1, length do
      local b = peek(i)
      if not b then break end
      temp[i] = b
    end
    table.insert(state.dump, temp)

    -- on EOF call appropriate parser and then reset state for that interface
    if state.p_flag and state.msgNumber == 9 then
      if type(patch) == "function" then
        pcall(patch, state.dump)
      else
        print("onSysex: patch() not available")
      end
      -- reset
      sysex_states[iface] = { msgNumber = 0, dump = {}, p_flag = false, g_flag = false, a_flag = false }
    elseif state.a_flag and state.msgNumber == 3 then
      if type(atrophy) == "function" then
        pcall(atrophy, state.dump)
      else
        print("onSysex: atrophy() not available")
      end
      sysex_states[iface] = { msgNumber = 0, dump = {}, p_flag = false, g_flag = false, a_flag = false }
    elseif state.g_flag and state.msgNumber == 5 then
      if type(global) == "function" then
        pcall(global, state.dump)
      else
        print("onSysex: global() not available")
      end
      sysex_states[iface] = { msgNumber = 0, dump = {}, p_flag = false, g_flag = false, a_flag = false }
    else
      -- advance message number only if there's an explicit numeric state
      state.msgNumber = (type(state.msgNumber) == "number") and (state.msgNumber + 1) or 0
    end
  end)
  if not ok then
    print("onSysex: error processing sysex - " .. tostring(err))
  end
end
