-- Unpack MIDI-style packed bytes (optimized for Lua 5.3)
-- Input layout: [MSB, b1, b2, b3, b4, b5, b6, b7, MSB2, ...]
-- MSB bit j (0..6) indicates that byte b{j+1} should have its high bit (0x80) set.
-- Returns: flat array of unpacked bytes.
local function unpack_midi(array)
  if type(array) ~= "table" then
    error("unpack_midi: expected table, got " .. type(array), 2)
  end
  local n = #array
  local result = {}
  local ri = 1
  -- step through groups of 8: msb + up to 7 bytes
  for i = 1, n, 8 do
    local msb = array[i]
    if not msb then break end
    -- process up to 7 following bytes
    -- use local variables and direct numeric index writes for speed
    for j = 0, 6 do
      local idx = i + j + 1
      if idx > n then break end
      local byte = array[idx]
      -- Lua 5.3 native bitwise: & and |
      if (msb & (1 << j)) ~= 0 then
        byte = byte | 0x80
      end
      result[ri] = byte
      ri = ri + 1
    end
  end
  return result
end
