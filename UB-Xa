-- Keep only the first header (msg[11]==1) and the following packet (msg[11]==2).
-- If we can't find a header+packet pair, return the original dump unchanged.
local function keep_first_header_packet(dump)
  local out = {}
  local found_header = false
  for idx, msg in ipairs(dump) do
    local msg_type = msg and msg[11]
    if not found_header and msg_type == HEADER_MSG_TYPE then
      out[#out+1] = msg
      found_header = true
    elseif found_header and msg_type == PACKET_MSG_TYPE then
      out[#out+1] = msg
      break
    end
  end
  if #out == 2 then
    return out
  else
    -- fallback: if format isn't as expected, return the original dump
    return dump
  end
end

