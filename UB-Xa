    parameterset({2,9},param1[15])                  -- OSC2 modes
    parameterMap.set (deviceId, 3, 533, param1[16])  -- Osc FEnv range
    parameterset({3,154,155},param1[17])            -- Osc1 state
    parameterMap.set (deviceId, 3, 518, param1[18])  -- Osc1 shapes
    -- 19?
    local paramlist = {519,520,536,525,534,526,537}
    for i = 1,7 do
      parameterMap.set (deviceId, 3, paramlist[i], param1[i+19])  -- Osc2 level
