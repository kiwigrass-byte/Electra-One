local suppressOutputs = true
local pendingSets = {} 
local orig_parameterMap_set = parameterMap.set 
parameterMap.set = function(dev, pt, p, v) 
  if suppressOutputs then pendingSets[#pendingSets + 1] = {dev, pt, p, v} return end 
  return orig_parameterMap_set(dev, pt, p, v) 
end
local function flushPendingSets() 
  if #pendingSets == 0 then return end 
  for _, entry in ipairs(pendingSets) do 
    local dev, pt, p, v = entry[1], entry[2], entry[3], entry[4] 
    orig_parameterMap_set(dev, pt, p, v) 
  end 
  pendingSets = {} 
end

