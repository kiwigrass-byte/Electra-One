-- parses the parameters and patch name from a patch sysEx dump
------------------------------------------------------------------------
local dump = {}       -- store message sequence
local msgNumber = 0    -- incoming message sequence counter (0 == start)
local p_flag = false   -- patch sequence
local g_flag = false   -- global sequence
local a_flag = false   -- atrophy sequence

------------------------------------------------------------------------------
-- This is lua equivalent of the php script by @Electrolove to extract the patch name from a UB-Xa patch sysEx dump
-- It uses 3 function: unpack_midi, parse_sysex, get_patch_name

-- Unpack MIDI-style packed bytes (optimized for Lua 5.3)
-- Input layout: [MSB, b1, b2, b3, b4, b5, b6, b7, MSB2, ...]
-- MSB bit j (0..6) indicates that byte b{j+1} should have its high bit (0x80) set.
-- Returns: flat array of unpacked bytes.
local function unpack_midi(array)
  if type(array) ~= "table" then
    error("unpack_midi: expected table, got " .. type(array), 2)
  end
  local n = #array
  local result = {}
  local ri = 1
  -- step through groups of 8: msb + up to 7 bytes
  for i = 1, n, 8 do
    local msb = array[i]
    if not msb then break end
    -- process up to 7 following bytes
    for j = 0, 6 do
      local idx = i + j + 1
      if idx > n then break end
      local byte = array[idx]
      if (msb & (1 << j)) ~= 0 then byte = byte | 0x80 end
      result[ri] = byte
      ri = ri + 1
    end
  end
  return result
end

function parse_sysex(messages)
  local string_char = string.char
  local table_concat = table.concat
  local unpack_midi_local = unpack_midi -- keep the external function lookup local
  local header = nil
  for mi = 1, #messages do
    local msg = messages[mi]
    if not msg then break end
    -- HEADER (marker value in msg[11] == 1)
    if msg[11] == 1 then
      local idx = 13
      -- safe access to the four type bytes
      local t1, t2, t3, t4 = msg[idx], msg[idx+1], msg[idx+2], msg[idx+3]
      local typ = string_char(t1 or 0, t2 or 0, t3 or 0, t4 or 0)
      idx = idx + 4
      -- safe 7-bit little-endian length unpack
      local b1 = msg[idx] or 0
      local b2 = msg[idx+1] or 0
      local b3 = msg[idx+2] or 0
      local b4 = msg[idx+3] or 0
      local length = (b1 & 0x7F) | ((b2 & 0x7F) << 7) | ((b3 & 0x7F) << 14) | ((b4 & 0x7F) << 21)
      idx = idx + 4
      -- read 16-byte name efficiently
      local name_parts = {}
      for i = 1, 16 do
        name_parts[i] = string_char(msg[idx] or 0)
        idx = idx + 1
      end
      local name = table_concat(name_parts)
      -- initialize data array with zeros (1..length)
      local data_array = {}
      for i = 1, length do data_array[i] = 0 end
      header = { name = name, length = length, type = typ, data = data_array }
    -- DATA PACKET (marker value in msg[11] == 2)
    elseif msg[11] == 2 and header then
      local packet_num = msg[12] or 0
      local packet_len = msg[13] or 0
      if packet_len > 0 then
        local start_idx = 14
        local end_idx = start_idx + packet_len - 1 -- corrected off-by-one
        local target_idx = (packet_num * 128) + 1
        -- copy available bytes into header.data, but don't write past header.length
        for i = start_idx, end_idx do
          local byte = msg[i]
          if not byte then break end
          if target_idx <= header.length then
            header.data[target_idx] = byte
          else
            -- if packet writes past expected length, stop writing
            break
          end
          target_idx = target_idx + 1
        end
      end
    -- END (use msg[4] == 0x7B as end marker)
    elseif msg[4] == 0x7B and header then
      -- call unpack_midi and then ensure table is exactly header.length long
      header.data = unpack_midi_local(header.data)
      if #header.data > header.length then
        -- trim extra elements in-place to avoid allocating a new table
        for i = header.length + 1, #header.data do
          header.data[i] = nil
        end
      end
      return header
    end
  end
  return nil
end

function get_patch_name(data)
  local startIdx = 79 
  local name = {}
  for i = startIdx, startIdx + 15, 2 do
    -- data[i] is the first byte, data[i+1] is the second byte
    local b1 = data[i]
    local b2 = data[i+1]
     -- Process the first character of the pair
    local char1 = ((b1 & 0x80) >> 7) + (b2 << 1)
    table.insert(name, string.char(char1))
    -- Process the second character of the pair
    local char2 = b1 & 0x7F
    table.insert(name, string.char(char2))
  end
  -- Combine the character array into a single string
  return table.concat(name)
end

function get_2byte_parameter(data,idx)
  if data[idx+1] == nil then return end
  -- data[i] is the first byte, data[i+1] is the second byte
  -- the parameter value is the unpacked second byte
  return math.floor(data[idx+1])
end

function get_1byte_parameter(data,idx)
  if data[idx] == nil then return end
  -- the parameter value is the unpacked first byte
  return math.floor(data[idx])
end

function get_nibble(data,idx)
  local byte = data[idx]
  -- Shift right by 4 bits to get the upper 4 bits
  local high_nibble = byte >> 4
  -- Mask with 0x0F (binary 00001111) to get the lower 4 bits
  local low_nibble = byte & 0x0F
  print(string.format("High: %X, Low: %X", high_nibble, low_nibble))
end

