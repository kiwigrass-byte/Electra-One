function getPatch(valueObject, value)
  -- ignore 0 (no change)
  if value == 0 then return end
  -- read parameters (validate nil)
  local bank = parameterMap.get(deviceId, PT_VIRTUAL, 10008)
  local raw   = parameterMap.get(deviceId, PT_VIRTUAL, 10009)
  if not bank or not raw then
    -- optional: log error for debugging
    -- trace("getPatch: missing bank or raw parameter")
    return
  end
  -- compute patch number correctly: raw is scaled (e.g. 12300 -> 123)
  local number = math.floor(raw / 100)
  -- clamp to valid 0..999
  number = math.max(0, math.min(999, number))
  -- create zero-padded ASCII digits "NNN" -> bytes
  local s = string.format("%03d", number)
  local p1 = string.byte(s, 1)
  local p2 = string.byte(s, 2)
  local p3 = string.byte(s, 3)
  -- construct sysex message (complete and terminated with 0xF7)
  local message = {
    0x00, 0x20, 0x32, 0x00, 0x01, 0x21, 0x7F, 0x74, 0x07, 0x03, 0x00,
    0x42, 0x49, 0x4E, 0x20, 0x50, 0x61, 0x74, 0x63, 0x68, 0x58, 0x20,
    bank, p1, p2, p3, 0x20, 0x20, 0x20, 0xF7
  }
  midi.sendSysex(currentPort, message)
  -- p_flag = true -- don't use until patch request is working
end

-- parse an x bit bitmask to a virtual parameter with values 0..2^x-1
function parameterset(params, value)
  local x = #params
  -- coerce to integer and keep only the lowest x bits (values: 0..2^x-1)
  local v = math.floor(tonumber(value) or 0) & (2^x - 1)
  local set = parameterMap.set
  local dev = deviceId
  local PT = PT_VIRTUAL
  -- reset all parameters once
  for _, p in ipairs(params) do
    if p ~= nil then set(dev, PT, p, 0) end
  end
  if v == 0 then return end
  -- set parameters according to bits of v (LSB -> p1)
  for i, p in ipairs(params) do
    if p ~= nil and ((v >> (i - 1)) & 1) ~= 0 then
      set(dev, PT, p, 1)
    end
  end
end
