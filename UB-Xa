-- helper function to extract ascii bytes from a number
local function asciiBytesFromNumber(n, width)
  local s = string.format("%0"..tostring(width).."d", n)
  local bytes = {}
  for i=1,#s do bytes[#bytes+1] = string.byte(s,i) end
  return bytes
end

function getPatch(valueObject, value)
  if value == 0 then return end
  local bank = parameterMap.get(deviceId, PT_VIRTUAL, 10008)
  local raw  = parameterMap.get(deviceId, PT_VIRTUAL, 10009)
  if not bank or not raw then return end
  local number = math.floor(raw / 100)
  number = math.max(0, math.min(999, number))
  local digits = asciiBytesFromNumber(number, 3)
  local message = {
    0x00,0x20,0x32,0x00,0x01,0x21,0x7F,0x74,0x07,0x03,0x00,
    0x42,0x49,0x4E,0x20,0x50,0x61,0x74,0x63,0x68,0x58,0x20,
    bank, digits[1], digits[2], digits[3], 0x20,0x20,0x20, 0xF7
  }
  midi.sendSysex(currentPort, message)
end

-- parse an x bit bitmask to a virtual parameter with values 0..2^x-1
function parameterset(params, value)
  local x = #params
  -- coerce to integer and keep only the lowest x bits (values: 0..2^x-1)
  local v = math.floor(tonumber(value) or 0) & (2^x - 1)
  local set = parameterMap.set
  local dev = deviceId
  local PT = PT_VIRTUAL
  -- reset all parameters once
  for _, p in ipairs(params) do
    if p ~= nil then set(dev, PT, p, 0) end
  end
  if v == 0 then return end
  -- set parameters according to bits of v (LSB -> p1)
  for i, p in ipairs(params) do
    if p ~= nil and ((v >> (i - 1)) & 1) ~= 0 then
      set(dev, PT, p, 1)
    end
  end
end

local sysex_states = {}
local VENDOR_ID = {0x00, 0x20, 0x32} -- Behringer
local MODEL_BYTE = 0x3A              -- UB-Xa model identifier
local HEADER_MSG_TYPE = 1
local PACKET_MSG_TYPE = 2
local EOF_SYSEX_SECOND_BYTE = 0x7E

local function safe_peek(sysexBlock, length, i)
  if type(i) ~= "number" or i < 1 or i > length then return nil end
  return sysexBlock:peek(i)
end

local function peek_string(sysexBlock, length, startIndex, count)
  if startIndex < 1 or count < 1 then return "" end
  local t = {}
  for j = 0, count - 1 do
    local b = safe_peek(sysexBlock, length, startIndex + j)
    if not b then break end
    t[#t+1] = string.char(b)
  end
  return table.concat(t)
end

local function is_vendor_match(sysexBlock, length)
  return safe_peek(sysexBlock, length, 2) == VENDOR_ID[1]
     and safe_peek(sysexBlock, length, 3) == VENDOR_ID[2]
     and safe_peek(sysexBlock, length, 4) == VENDOR_ID[3]
end

-- per-interface sysex state
local sysex_states = {}
local VENDOR_ID = {0x00, 0x20, 0x32} -- Behringer
local MODEL_BYTE = 0x3A              -- UB-Xa model identifier
local HEADER_MSG_TYPE = 1
local PACKET_MSG_TYPE = 2
local EOF_SYSEX_SECOND_BYTE = 0x7E

local function safe_peek(sysexBlock, length, i)
