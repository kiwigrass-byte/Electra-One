-------------------------------------------bitmasked parameters -------------------------------------------------------------------------------------
function sendNrpn(port, channel, parameter, value)
  if suppressOutputs then return end 
  local pMSB = (parameter >> 7) & 0x7F
  local pLSB = parameter & 0x7F
  local vMSB = (value >> 7) & 0x7F
  local vLSB = value & 0x7F
  midi.sendControlChange(port, channel, 99, pMSB)
  midi.sendControlChange(port, channel, 98, pLSB)
  midi.sendControlChange(port, channel, 6, vMSB)
  midi.sendControlChange(port, channel, 38, vLSB)
end

-- bitmask helper function ---
function sendBitmask(paramNumber, deviceIndex, paramList)
  -- paramList is a list of virtual parameter indices where LSB->first element
  local result = 0
  local dev = deviceIndex or 1
  for i,p in ipairs(paramList) do
    if p and parameterMap.get(dev, PT_VIRTUAL, p) ~= 0 then
      result = result + (1 << (i-1))
    end
  end
  sendNrpn(currentPort, currentChannel, paramNumber, result)
end

