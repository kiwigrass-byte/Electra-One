function global(dump)
  -- set to true to get verbose prints for debugging
  local DEBUG = false
  -- basic validation
  if type(dump) ~= "table" or #dump == 0 then
    if DEBUG then print("global: invalid dump") end
    return
  end
  -- safe adjustments that were in the original
  if type(dump[4]) == "table" then
    dump[4][12] = 1 -- keep the original intention but only when safe
  elseif DEBUG then
    print("global: dump[4] missing or not a table")
  end
  if #dump >= 3 then
    table.remove(dump, 3)
  elseif DEBUG then
    print("global: not enough rows to remove index 3")
  end
  -- parse
  local result = parse_sysex(dump)
  if not result or type(result.data) ~= "table" then
    if DEBUG then print("Could not read data") end
    return
  end
  -- cache globals/functions for speed
  local dev = deviceId
  local pset = parameterMap.set
  local gip  = get_1byte_parameter
  local data = result.data
  -- optional:
  --if DEBUG then
    for i = 1, 56 do
      local v = gip(data, i)
      print(string.format("1-byte global parameter: %d value: %s", i, tostring(v)))
    end
  --end
  -- mapping: { page, parameterNumber, paramIndexInSysex }
  -- (keeps original mapping; note duplicates below are as in original code)
  local mappings = {
    {3,  8,   2}, -- 1 is RFU
    {3,  9,   3},
    {3,  10,  4},
    {3,  136, 5},
    {3,  137, 6},
    {3,  904, 7}, -- 8,9,10,11 are RFU
    {3,  909,  12}, -- 13,14 are UI lastPatch and UIDisable bitmasked settings
    {3,  912,  15}, 
    {3,  1152, 16},
    {3,  1154, 17},
    {3,  1155, 18}, -- 19-27 are MIDI settings
    {3,  1165, 28},
    {3,  1281, 29},
    {3,  1282, 30},
    {3,  1283, 31},
    {3,  1284, 32},
    {3,  1408, 33},
    {3,  1409, 34},
    {3,  1410, 35},
    {3,  1411, 36},
    {3,  1412, 37},
    {3,  1413, 38},
    {3,  1414, 39},
    {3,  1415, 40},
    {3,  1416, 41},
    {3,  1417, 42}, -- Vib pedal assign
    {3,  1418, 43}, -- Vib pedal action
    {3,  1419, 44}, -- Vib pedal min
    {3,  1420, 45}, -- Vib pedal max
    {3,  1421, 46}, -- Filter pedal assign? (duplicate)
    {3,  1422, 47}, -- Filter pedal action? (duplicate)
    {3,  1423, 48}, -- Filter pedal min? (duplicate)
    {3,  1424, 49}, -- Filter pedal max? (duplicate)
  }
  -- apply mappings
  for _, m in ipairs(mappings) do
    local page, number, pindex = m[1], m[2], m[3]
    local value = gip(data, pindex)
    -- in case gip returns nil explicitly, we still call set to keep parity with original
    if DEBUG then
      print(string.format("set deviceId=%s page=%d param=%d <- paramG[%d]=%s", tostring(dev), page, number, pindex, tostring(value)))
    end
    pset(dev, page, number, value)
  end
  -- restore/cleanup original globals
  g_flag = false
  dump = {}
  msgNumber = 0
end
