-- request patchX %c%03d 
function getPatch(valueObject, value)
  if value == 0 then return end
  local bank = parameterMap.get(deviceId, PT_VIRTUAL, 6032) + 65
  local number  = parameterMap.get(deviceId, PT_VIRTUAL, 6033)
  local digits = asciiBytesFromNumber(number, 3)
  local message = {0x00, 0x20, 0x32, 0x00, 0x01, MODEL_BYTE, 0x7F, 0x74, 0x07,
    0x03, 0x00, 0x42, 0x49, 0x4E, 0x20, 0x50, 0x61, 0x74, 0x63, 0x68,
    0x58, 0x20, bank, digits[1], digits[2], digits[3], 0x20,0x20,0x20}
  midi.sendSysex (currentPort, message)
end

-- helper function to parse an x bit bitmask to a virtual parameter with values 0..2^x-1
function pset(params, value)
  local x = #params
  -- coerce to integer and keep only the lowest x bits (values: 0..2^x-1)
  local v = math.floor(tonumber(value) or 0) & (2^x - 1)
  local set = parameterMap.set
  local dev = deviceId
  local PT = PT_VIRTUAL
  -- reset all parameters once
  for _, p in ipairs(params) do
    if p ~= nil then set(dev, PT, p, 0) end
  end
  if v == 0 then return end
  -- set parameters according to bits of v (LSB -> p1)
  for i, p in ipairs(params) do
    if p ~= nil and ((v >> (i - 1)) & 1) ~= 0 then
      set(dev, PT, p, 1)
    end
  end
end

-- helper functions and globals for midi.onSysex 
local sysex_states = {}
local VENDOR_ID = {0x00, 0x20, 0x32} -- Behringer
--local MODEL_BYTE_D = 0x3A             -- UB-Xa D model identifier
--local MODEL_BYTE = 0x21             -- UB-Xa model identifier
local HEADER_MSG_TYPE = 1
local PACKET_MSG_TYPE = 2
local EOF_SYSEX_SECOND_BYTE = 0x7E
local EOF_SYSEX_FOURTH_BYTE = 0x7B

function safe_peek(sysexBlock, length, i)
  if type(i) ~= "number" or i < 1 or i > length then return nil end
  return sysexBlock:peek(i)
end

function peek_string(sysexBlock, length, startIndex, count)
  if startIndex < 1 or count < 1 then return "" end
  local t = {}
  for j = 0, count - 1 do
    local b = safe_peek(sysexBlock, length, startIndex + j)
    if not b then break end
    t[#t+1] = string.char(b)
  end
  return table.concat(t)
end

function is_vendor_match(sysexBlock, length)
  return safe_peek(sysexBlock, length, 2) == VENDOR_ID[1]
     and safe_peek(sysexBlock, length, 3) == VENDOR_ID[2]
     and safe_peek(sysexBlock, length, 4) == VENDOR_ID[3]
end

function reset_state_for_iface(iface)
  sysex_states[iface] = { msgNumber = 0, section = 0, dump = {}, p_flag = false, g_flag = false, a_flag = false, active = false, last_ts = nil }
end

function midi.onSysex(midiInput, sysexBlock)
  local ok, err = pcall(function()
  local length = sysexBlock:getLength()
  local iface = tostring(midiInput.interface or midiInput.name or "unknown")
  local state = sysex_states[iface]
  if not state then
    reset_state_for_iface(iface)
    state = sysex_states[iface]
  end
  local peek = function(i) return safe_peek(sysexBlock, length, i) end
  -- If starting a new transfer, reset dump
  if state.msgNumber == 0 then
    state.dump = {}
    state.section = 0
    state.p_flag = false
    state.g_flag = false
    state.a_flag = false
  end
  -- HEADER detection:
  if length > 6 and peek(11) == HEADER_MSG_TYPE then -- header seen. decide whether it's a new transfer or a bona fide additional header. 
    local expected_header_msgnum = 1 + (state.section or 0) * 2 
    if state.msgNumber ~= 0 and state.msgNumber ~= expected_header_msgnum then -- We're in the middle of a transfer but this header is NOT the expected header for that transfer.  
      print("onSysex: unexpected header while msgNumber=" .. tostring(state.msgNumber) .. "; resetting state and starting new transfer") 
      reset_state_for_iface(iface) state = sysex_states[iface] -- Treat it as the start of a new transfer to avoid appending onto a corrupted/partial dump.
    end
    if state.msgNumber == 0 then
      -- start of first header
      state.section = 0
      state.msgNumber = 1
      -- validate vendor & model on initial header
      if not is_vendor_match(sysexBlock, length) then
        print("onSysex: Not Behringer vendor; ignoring message")
        -- reset to safe state
        reset_state_for_iface(iface)
        return
      end
      if peek(7) ~= MODEL_BYTE then
        print("onSysex: Not UB-Xa model; ignoring message")
        reset_state_for_iface(iface)
        return
      end
      -- set dump type based on header text (only for first header)
      local hdrText = peek_string(sysexBlock, length, 21, 12) -- positions 21..32
      local tl = hdrText:lower()
      if tl:find("upper patch", 1, true) or tl:find("lower patch", 1, true) or tl:find("patchx", 1, true) then
        state.p_flag, state.g_flag, state.a_flag = true, false, false
      elseif tl:find("global", 1, true) then
        state.g_flag, state.p_flag, state.a_flag = true, false, false
      elseif tl:find("atrophy", 1, true) then
        state.a_flag, state.p_flag, state.g_flag = true, false, false
      end
    else
      -- additional header inside the same transfer -> advance section
      state.section = (state.section or 0) + 1
      state.msgNumber = 1 + state.section * 2  -- 3, 5, ...
      -- do NOT reset flags: dump type determined by first header
    end
  end
  -- PACKET detection: compute packet msgNumber relative to current section. There is 7 packets for a patch dump, 1 for a global, 1 for atrophy profile
  for i = 0, 13 do
    if length > 6 and peek(11) == PACKET_MSG_TYPE and peek(12) == i then
      state.msgNumber = i + 2 + (state.section or 0) * 2
    end
  end
  -- EOF detection
  local secondByte = peek(2)
  local fourthByte = peek(4)
  if length == 6 and secondByte == EOF_SYSEX_SECOND_BYTE and fourthByte == EOF_SYSEX_FOURTH_BYTE then
    if state.p_flag then
      state.msgNumber = 9
    elseif state.a_flag then
      state.msgNumber = 3
    elseif state.g_flag then
      state.msgNumber = 3
    end
  end
  -- Logging
  print(string.format("sysex (msg=%d) message received: interface=%s length=%d",
    state.msgNumber, iface, length))
  for startIndex = 1, length, 16 do
    local bytes = {}
    local endIndex = math.min(startIndex + 15, length)
    for i = startIndex, endIndex do
      local b = peek(i) or 0
      bytes[#bytes + 1] = string.format("%02X", b)
    end
    print(string.format("data[%04X]: %s", startIndex - 1, table.concat(bytes, " ")))
  end
  -- collect each message into dump
  local temp = {}
  for i = 1, length do
    local b = peek(i)
    if not b then break end
    temp[i] = b
  end
  table.insert(state.dump, temp)
  -- call the appropriate handler on EOF for each type
  if state.p_flag and state.msgNumber == 9 then
    if type(patch) == "function" then pcall(patch, state.dump) else print("onSysex: patch() not available") end
    -- reset state
    reset_state_for_iface(iface)
    return
  elseif state.a_flag and state.msgNumber == 3 then
    if type(atrophy) == "function" then pcall(atrophy, state.dump) else print("onSysex: atrophy() not available") end
    reset_state_for_iface(iface)
    return
  elseif state.g_flag and state.msgNumber == 3 then
    if type(global) == "function" then pcall(global,state.dump) else print("onSysex: global() not available") end
    reset_state_for_iface(iface)
    return
  end
  -- advance message number for next call
  if type(state.msgNumber) == "number" then
    state.msgNumber = state.msgNumber + 1
  else
    state.msgNumber = 0
  end
end)

  if not ok then
    print("onSysex: pcall failed: " .. tostring(err))
  end
end

-- process a patch dump
function patch(dump)
  -- parse of the incoming dump
  local result = parse_sysex(dump)
  if not result or type(result.data) ~= "table" then
    print("Could not read data")
    return
  end
  local param2 = {}  -- store 2 byte parameters
  local param1 = {}  -- store 1 byte parameters
  local data = result.data
  -- print patch name to screen
  patchName = get_patch_name(data) -- update global patchName
  info.setText(patchName)
  local idx = 1
  for i = 1,77,2 do -- loop through the 2-byte patch parameters - parameter value is located in the 2nd byte of pair
    param2[idx] = data[i+1]
--    print("patch: 2nd 2-byte parameter " .. idx .. ": " .. data[i+1])
    idx = idx+1
  end
  local idx = 1
  for i = 95,155 do -- loop through the 1-byte parameters that start at byte 95 after the patch name bytes.  
    param1[idx] = data[i]
--    print("patch: 1-byte parameter: ".. idx .. ": " .. data[i])
    idx = idx + 1
  end
  -- Assign the 39 2-byte parameters. Multiple 0-255 range parameters by 64 to scale to the 0-16383 (14-bit) range of nrpn
  -- The result doesn't match exactly the UB-Xa because the range of a 2-byte parameter is actually 0-65535 (16-bit)
  -- See manual for description of the nrpn 
  local paramList = {0,1,2,3,128,256,257,258,259,260,384,385,386,387,388,389,390,391,392,393,394,395,396,512,513,514,515,640,641,642,643,768,770,772,774,769,771,773,775}
  for i = 1,39 do
    parameterMap.set (deviceId, 3, paramList[i], param2[i]*64) 
  end
  -- Assign the 1-byte parameters to E1 patch parameters. Some are bitmasked and treated separately.
  local singleParams = {
    {4, 1},      -- unison mode toggle 
    {5, 2},      -- poly voice #
    {6, 3},      -- unison voice #
    -- { , 4},   -- 4 ?? (skipped)
    {11, 5},     -- portamento spread
    {12, 6},     -- portamento range
    {262, 8},    -- LFO shape
    {533, 16},   -- Osc FEnv range
    {518, 18},   -- Osc1 shape
    -- { , 19}, -- 19 ?? (skipped)
    {519, 20},   -- Osc2 level
    {520, 21},   -- Osc2 shape
    {536, 22},   -- Osc2 quantize
    {525, 23},   -- Osc1 lfo amount
    {534, 24},   -- Osc2 lfo amount
    {526, 25},   -- Osc1 pwm lfo amount
    {537, 26},   -- Osc2 pwm lfo amount
    {664, 28},   -- Range of filter tracking
    {650, 29},   -- Range of filter envelope
    {647, 30},   -- Range of filter frequency
    {653, 31},   -- Range of filter LFO
    {657, 32},   -- Range of filter pedal
    {776, 33},   -- mod source 1
    {777, 34},   -- mod dest 1
    {780, 35},   -- mod source 2
    {781, 36},   -- mod dest 2
    {784, 37},   -- mod source 3
    {785, 38},   -- mod dest 3
    {788, 39},   -- mod source 4
    {789, 40},   -- mod dest 4
    {778, 41},   -- mod source 5
    {779, 42},   -- mod dest 5
    {782, 43},   -- mod source 6
    {783, 44},   -- mod dest 6
    {786, 45},   -- mod source 7
    {787, 46},   -- mod dest 7
    {790, 47},   -- mod source 8
    {791, 48},   -- mod dest 8
    {913, 58},   -- Atrophy preference
    {1152, 59},  -- patch midi transpose
-- (62 is RFU)    
    {2056, 61},  -- VCA LFO Amount
  }
  -- Batch assign parameters
  for _, pair in ipairs(singleParams) do
    parameterMap.set(deviceId, 3, pair[1], param1[pair[2]])
  end
  -- Assign multi-parameter (bit masked) groups
  local paramGroups = {
    {7, {37,38,39,40}},                 -- 261 LFO modulation
    {9, {50,51,27}},                    -- 263 CH1 LFO destinations
    {10, {30,31}},                      -- 264 CH1 quant/invert
    {11, {33,35,44}},                   -- 265 CH2 LFO destinations
    {12, {49,46}},                      -- 266 CH2 quant/invert
    {13, {136,137,138,139,140}},        -- 397 Filter env mods
    {14, {141,142,143,144,145}},        -- 398 VCA env mods
    {15, {2,9}},                        -- 516 OSC2 modes
    {17, {3,154,155}},                  -- 517 Osc1 state
    {27, {76,89}},                      -- 644 Filter key track and mode
  }
  for _, group in ipairs(paramGroups) do
    pset(group[2], param1[group[1]])
  end
  print("-- parse of the incoming dump")
  -- Assign ARP parameters to upperDevice
  local arpParams = {
    {1024, 49},  -- ARP enable
    {1025, 50},  -- ARP mode
    {1026, 51},  -- ARP hold
    {1027, 52},  -- ARP time
    {1028, 53},  -- ARP gate length
    {1029, 54},  -- ARP sync
    {1030, 55},  -- ARP octave range
  }
  for _, pair in ipairs(arpParams) do
    parameterMap.set(upperDevice:getId(), 3, pair[1], param1[pair[2]])
  end
  -- restore/cleanup original globals
  p_flag = false
  dump = {}
  msgNumber = 0
  print("patch settings parsed. Number of bytes: ".. #data)
end

