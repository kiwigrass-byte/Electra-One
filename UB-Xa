-- panning control parameter
function setPanType(valueObject, type)
  if type == nil then return end
  local widthControl = math.min(parameterMap.get(deviceId, PT_VIRTUAL,201),100)
  local paramList = {
    2176,2177,2178,2179,2180,2181,2182,2183,
    2184,2185,2186,2187,2188,2189,2190,2191
  }
  local value = 0
  local steps = {0, 85, 170, 255}
  for i, param in ipairs(paramList) do  
    if     type == 0 then value = 128 --  center all (128);
    elseif type == 1 then value = (i % 2 == 1) and 0 or 255 -- alternate left/right: odd indices -> 0, even indices -> 255   
    elseif type == 2 then value = steps[((i - 1) % 4) + 1] -- four-step pan groups: 0, 64, 192, 255 repeating every 4 voices
    else value = math.random(0, 255) -- random 
    end    
    parameterMap.set(deviceId, PT_NRPN, param, math.floor(128+(value-128)*widthControl/100))
    panDefValue[i]=value
  end  
end 

function setPanWidth(valueObject, value)
  local widthControl = parameterMap.get(deviceId, PT_VIRTUAL,201)
  local paramList = {
    2176,2177,2178,2179,2180,2181,2182,2183,
    2184,2185,2186,2187,2188,2189,2190,2191
  }
  for i, param in ipairs(paramList) do
    --print ("i : "..i..", param;"..param.." panDefValue[i]: "..panDefValue[i].." widthControl: "..widthControl)
    parameterMap.set(deviceId, PT_NRPN, param, math.max(math.min(math.floor(128+(panDefValue[i]-128)*widthControl/100),255),0))   
  end
end

function setPanDefault(valueObject, value)
  local parameterNumber = valueObject:getMessage ():getParameterNumber ()
  panDefValue[parameterNumber+1-2176] = value+128
end

-- bitmask helper function ---
function sendBitmask(paramNumber, deviceId, paramList)
  -- paramList is a list of virtual parameter indices where LSB->first element
  local value = 0
  for i,p in ipairs(paramList) do
    if p and parameterMap.get(deviceId, PT_VIRTUAL, p) ~= 0 then
      value = value + (1 << (i-1))
    end
  end
  local pMSB = (paramNumber >> 7) & 0x7F
  local pLSB = paramNumber & 0x7F
  local vMSB = (value >> 7) & 0x7F
  local vLSB = value & 0x7F
  midi.sendControlChange(currentPort, currentChannel, 99, pMSB)
  midi.sendControlChange(currentPort, currentChannel, 98, pLSB)
  midi.sendControlChange(currentPort, currentChannel, 6, vMSB)
  midi.sendControlChange(currentPort, currentChannel, 38, vLSB)
end

